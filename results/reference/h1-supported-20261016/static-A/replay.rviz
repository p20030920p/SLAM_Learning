Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/PointCloud2
    Name: RAW
    Enabled: true
    Topic:
      Value: /own/raw
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Style: Points
    Size (Pixels): 4
    Color Transformer: FlatColor
    Color: 175; 175; 175
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: TEMPORAL
    Enabled: true
    Topic:
      Value: /own/temporal
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Style: Points
    Size (Pixels): 4
    Color Transformer: FlatColor
    Color: 40; 180; 255
    Position Transformer: XYZ
  - Class: rviz_default_plugins/Marker
    Name: Input replay status
    Enabled: true
    Topic:
      Value: /own/status
      Reliability Policy: Reliable
      Depth: 1
  Global Options:
    Background Color: 18; 22; 28
    Fixed Frame: map
    Frame Rate: 15
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: 2D A input replay
      Target Frame: map
      X: 7.4750000000000005
      Y: 1.100000000000001
      Scale: 44.54237288135594
      Angle: 0
Window Geometry:
  Height: 900
  Width: 1320
  X: 420
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: false
