Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Arena grid (1 m)
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 60
    Color: 60; 70; 82
    Alpha: 0.35
  - Class: rviz_default_plugins/Odometry
    Name: Wheel odometry
    Enabled: true
    Topic:
      Value: /omni_drive_controller/odom
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 10
    Keep: 1
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Shape:
      Value: Arrow
      Shaft Length: 0.5
      Shaft Radius: 0.06
      Head Length: 0.2
      Head Radius: 0.12
    Color: 255; 50; 180
    Covariance:
      Value: false
  - Class: rviz_default_plugins/PointCloud2
    Name: LIVE 16-CHANNEL 3D POINTS
    Enabled: true
    Topic:
      Value: /points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
    Decay Time: 2.0
  Global Options:
    Background Color: 18; 22; 28
    Fixed Frame: odom
    Frame Rate: 15
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: LIVE 3D ACQUISITION
      Target Frame: odom
      Distance: 11.5
      Pitch: 0.8
      Yaw: 0.8
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.5
Window Geometry:
  Height: 900
  Width: 1320
  X: 480
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: false
