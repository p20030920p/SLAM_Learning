Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Arena grid (1 m)
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 60
    Color: 60; 70; 82
    Alpha: 0.35
  - Class: rviz_default_plugins/MarkerArray
    Name: Moving boxes
    Enabled: true
    Topic:
      Value: /live/markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Marker
    Name: Driven trajectory
    Enabled: true
    Topic:
      Value: /live/trajectory
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/Odometry
    Name: Wheel odometry
    Enabled: true
    Topic:
      Value: /omni_drive_controller/odom
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 10
    Keep: 1
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Shape:
      Value: Arrow
      Shaft Length: 0.5
      Shaft Radius: 0.06
      Head Length: 0.2
      Head Radius: 0.12
    Color: 30; 190; 90
    Covariance:
      Value: false
  - Class: rviz_default_plugins/TF
    Name: TF frames
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.6
    Update Interval: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Frozen lidar map A
    Enabled: true
    Topic:
      Value: /probe/map_points
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Color Transformer: FlatColor
    Color: 155; 165; 180
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 2
  - Class: rviz_default_plugins/PointCloud2
    Name: Actual depth (aligned by green estimate)
    Enabled: true
    Topic:
      Value: /depth/points
      Reliability Policy: Best Effort
      Depth: 1
    Color Transformer: FlatColor
    Color: 255; 200; 60
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 1
  - Class: rviz_default_plugins/Path
    Name: Plain ICP path
    Enabled: true
    Topic:
      Value: /plain/probe_path
      Depth: 1
    Color: 245; 90; 90
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Plain ICP
    Enabled: true
    Topic:
      Value: /plain/probe_pose
      Depth: 1
    Color: 245; 90; 90
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  - Class: rviz_default_plugins/Path
    Name: H1 Robust + odometry path
    Enabled: true
    Topic:
      Value: /guard/probe_path
      Depth: 1
    Color: 240; 210; 60
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: H1 Robust + odometry
    Enabled: true
    Topic:
      Value: /guard/probe_pose
      Depth: 1
    Color: 240; 210; 60
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  - Class: rviz_default_plugins/Path
    Name: H2 Guard + depth path
    Enabled: true
    Topic:
      Value: /depth/probe_path
      Depth: 1
    Color: 255; 150; 45
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: H2 Guard + depth
    Enabled: true
    Topic:
      Value: /depth/probe_pose
      Depth: 1
    Color: 255; 150; 45
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  - Class: rviz_default_plugins/Path
    Name: H3 Lidar-only search path
    Enabled: true
    Topic:
      Value: /search/probe_path
      Depth: 1
    Color: 210; 100; 255
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: H3 Lidar-only search
    Enabled: true
    Topic:
      Value: /search/probe_pose
      Depth: 1
    Color: 210; 100; 255
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  - Class: rviz_default_plugins/Path
    Name: H3 Depth + search path
    Enabled: true
    Topic:
      Value: /recover/probe_path
      Depth: 1
    Color: 75; 235; 160
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: H3 Depth + search
    Enabled: true
    Topic:
      Value: /recover/probe_pose
      Depth: 1
    Color: 75; 235; 160
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  - Class: rviz_default_plugins/Path
    Name: Native AMCL / GICP path
    Enabled: true
    Topic:
      Value: /native/probe_path
      Depth: 1
    Color: 70; 165; 255
    Line Width: 0.035
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Native AMCL / GICP
    Enabled: true
    Topic:
      Value: /native/pcl_pose
      Depth: 1
    Color: 70; 165; 255
    Shape: Arrow
    Shaft Length: 0.4
    Head Length: 0.15
  Global Options:
    Background Color: 18; 22; 28
    Fixed Frame: map
    Frame Rate: 15
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D input, planar robot hypotheses
      Target Frame: map
      Distance: 18.0
      Pitch: 0.8
      Yaw: 0.8
      Focal Point:
        X: 7.15
        Y: -3.95
        Z: 0.5
Window Geometry:
  Height: 720
  Width: 960
  X: 960
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: false
