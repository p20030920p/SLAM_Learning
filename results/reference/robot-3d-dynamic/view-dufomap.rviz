Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 60; 70; 82
    Enabled: true
    Name: Arena grid (1 m)
    Plane Cell Count: 60
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Moving boxes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Value: /live/markers
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Driven trajectory
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Value: /live/trajectory
  - Angle Tolerance: 0.1
    Class: rviz_default_plugins/Odometry
    Color: 30; 190; 90
    Covariance:
      Value: false
    Enabled: true
    Keep: 1
    Name: Wheel odometry
    Position Tolerance: 0.05
    Shape:
      Head Length: 0.2
      Head Radius: 0.12
      Shaft Length: 0.5
      Shaft Radius: 0.06
      Value: Arrow
    Topic:
      Depth: 10
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      Value: /omni_drive_controller/odom
  - Class: rviz_default_plugins/TF
    Enabled: true
    Marker Scale: 0.6
    Name: TF frames
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Update Interval: 0
  - Axis: Z
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Name: Independent 3D LiDAR (live)
    Position Transformer: XYZ
    Size (Pixels): 2
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      Value: /points
  - Class: rviz_default_plugins/PointCloud2
    Name: Frozen dufomap 3D map
    Enabled: true
    Topic:
      Value: /dufomap/initial_map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Color: 80; 180; 255
    Style: Points
    Size (Pixels): 1
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: Native GICP pose
    Enabled: true
    Topic:
      Value: /dufomap/pcl_pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Color: 80; 180; 255
  - Class: rviz_default_plugins/Path
    Name: Native GICP trajectory
    Enabled: true
    Topic:
      Value: /dufomap/view/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Color: 80; 180; 255
    Line Width: 0.05
  Global Options:
    Background Color: 18; 22; 28
    Fixed Frame: map
    Frame Rate: 15
  Tools: []
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D map comparison
      Target Frame: map
      Distance: 16.0
      Pitch: 0.75
      Yaw: 0.8
      Focal Point:
        X: 7.322699999999999
        Y: 6.6812000000000005
        Z: 0.35
Window Geometry:
  Displays:
    collapsed: false
  Height: 720
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 960
  X: 980
  Y: 0
