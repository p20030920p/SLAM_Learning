<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="competition_world">
    <gravity>0 0 -9.8</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <model name="s4_corridor_wall_north">
      <static>true</static><pose>7.15 -1.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 0.16 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.16 1.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.42 0.42 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>
    
    <model name="s4_corridor_wall_south">
      <static>true</static><pose>7.15 -4.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 0.16 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.16 1.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.42 0.42 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>
<model name="corridor_end_west"><static>true</static><pose>-2.93 -3.1 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.16 3.16 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 3.16 1.5</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual></link></model><model name="corridor_end_east"><static>true</static><pose>17.23 -3.1 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.16 3.16 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.16 3.16 1.5</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual></link></model></world>
</sdf>