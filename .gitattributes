* text=auto eol=lf
*.png binary
*.gif binary
*.mp4 binary
*.pcd binary
*.zip binary
results/reference/** -text whitespace=-blank-at-eol
results/localization/static-dynamic/** -text whitespace=-blank-at-eol
*.pdf binary

docs/media/hardware/** -text whitespace=-blank-at-eol

# Preserve inspected upstream URDF bytes, including the exporter's comment spacing.
config/robot_profiles/omni-3d-v1/omni_car_lidar3d.urdf -text whitespace=-blank-at-eol
config/presentation/worlds/** -text whitespace=-blank-at-eol
# Native configuration/stdout bytes are hash-bound, including trailing empty lines.
results/reference/robot-*/** whitespace=-blank-at-eol,-blank-at-eof
results/reference/desktop-*/** whitespace=-blank-at-eol,-blank-at-eof
