{
  "Panels": [
    {
      "Class": "rviz_common/Displays",
      "Name": "Displays"
    },
    {
      "Class": "rviz_common/Views",
      "Name": "Views"
    }
  ],
  "Visualization Manager": {
    "Class": "",
    "Name": "root",
    "Enabled": true,
    "Global Options": {
      "Fixed Frame": "physical_lidar",
      "Frame Rate": 20,
      "Background Color": "28; 28; 32"
    },
    "Displays": [
      {
        "Class": "rviz_default_plugins/Grid",
        "Name": "Grid (1m)",
        "Enabled": true,
        "Value": true,
        "Cell Size": 1,
        "Plane": "XY",
        "Plane Cell Count": 20
      },
      {
        "Class": "rviz_default_plugins/TF",
        "Name": "Frames",
        "Enabled": false,
        "Value": false
      },
      {
        "Class": "rviz_default_plugins/PointCloud2",
        "Name": "Current cloud",
        "Enabled": true,
        "Value": true,
        "Topic": {
          "Value": "/physical/lidar/points",
          "Depth": 5,
          "History Policy": "Keep Last",
          "Reliability Policy": "Reliable",
          "Durability Policy": "Volatile"
        },
        "Color Transformer": "Intensity",
        "Position Transformer": "XYZ",
        "Style": "Points",
        "Size (Pixels)": 2,
        "Size (m)": 0.01,
        "Decay Time": 0,
        "Queue Size": 5,
        "Channel Name": "intensity",
        "Use Fixed Frame": true
      },
      {
        "Class": "rviz_default_plugins/Path",
        "Name": "Odometry trajectory",
        "Enabled": false,
        "Value": false,
        "Topic": {
          "Value": "/physical/trajectory",
          "Depth": 5,
          "History Policy": "Keep Last",
          "Reliability Policy": "Reliable",
          "Durability Policy": "Volatile"
        },
        "Color": "255; 180; 0",
        "Line Style": "Lines",
        "Line Width": 0.03,
        "Buffer Length": 1
      },
      {
        "Class": "rviz_default_plugins/Marker",
        "Name": "Tracking status",
        "Enabled": true,
        "Value": true,
        "Topic": {
          "Value": "/physical/tracking",
          "Depth": 5,
          "History Policy": "Keep Last",
          "Reliability Policy": "Reliable",
          "Durability Policy": "Volatile"
        },
        "Queue Size": 10
      },
      {
        "Class": "rviz_default_plugins/PointCloud2",
        "Name": "Odometry local map",
        "Enabled": false,
        "Value": false,
        "Topic": {
          "Value": "/odom_local_map",
          "Depth": 5,
          "History Policy": "Keep Last",
          "Reliability Policy": "Reliable",
          "Durability Policy": "Volatile"
        },
        "Color Transformer": "FlatColor",
        "Position Transformer": "XYZ",
        "Style": "Points",
        "Size (Pixels)": 2,
        "Size (m)": 0.01,
        "Decay Time": 0,
        "Queue Size": 5,
        "Channel Name": "intensity",
        "Use Fixed Frame": true
      }
    ],
    "Views": {
      "Current": {
        "Class": "rviz_default_plugins/Orbit",
        "Name": "Current View",
        "Distance": 10.0,
        "Pitch": 0.3,
        "Yaw": 0.7,
        "Focal Point": {
          "X": 0,
          "Y": 0,
          "Z": 0
        },
        "Target Frame": "physical_lidar"
      },
      "Saved": []
    },
    "Tools": [
      {
        "Class": "rviz_default_plugins/Interact"
      },
      {
        "Class": "rviz_default_plugins/MoveCamera"
      }
    ]
  },
  "Window Geometry": {
    "Width": 1400,
    "Height": 900,
    "X": 60,
    "Y": 40,
    "Displays": {
      "collapsed": false
    },
    "Views": {
      "collapsed": false
    }
  }
}
