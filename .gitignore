# colcon / ament build artefacts
build/
install/
log/

# catkin (week-style workspaces, kept for compatibility)
devel/
.catkin_tools/
**/build/
**/devel/
**/install/
**/log/
**/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editors
.vscode/
.idea/
*.swp

# Gazebo camera sensor default dump directory (top_camera::link::top_view_*.png)
__default__/

# Reproductions: upstream checkouts and datasets stay on the machine that runs
# them. Only what we write (plans, scripts, small results) is committed — the
# .gitkeep files keep the two folders visible in a fresh clone.
reproductions/**/code/*
reproductions/**/data/*
!reproductions/**/code/.gitkeep
!reproductions/**/data/.gitkeep
